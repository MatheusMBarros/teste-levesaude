# Nenhuma variável é obrigatória para GET /agendas e POST /agendamento.

# Triagem (POST /triagem). `fake` classifica por palavras-chave, sem chave nem rede, para rodar
# `cp .env.example .env && npm run dev` direto. Sem `.env`, o padrão é `anthropic`.
# `fake` é só para execução local: o deploy exige TRIAGE_PROVIDER=anthropic explícito (ADR-009).
# Valores: anthropic | fake
TRIAGE_PROVIDER=fake

# Modelo usado quando TRIAGE_PROVIDER=anthropic.
TRIAGE_MODEL=claude-sonnet-5

# Obrigatória só com TRIAGE_PROVIDER=anthropic; vazia, POST /triagem responde 503. Nunca commitar.
ANTHROPIC_API_KEY=
